# ——— Villa Mima environment variables ———
# Copy to .env.local for local dev; add the same keys in Vercel → Project → Settings →
# Environment Variables for production. Step-by-step setup lives in README.md.
#
# SECURITY RULE (see CLAUDE.md): the private Hosthub iCal URL must NEVER appear
# here or anywhere in this project. The public calendar endpoint needs no key.

# — Supabase (enquiry storage) —
# Project URL: Supabase dashboard → Project Settings → API
SUPABASE_URL=
# Service-role key (server-only — never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# — Resend (enquiry email notifications) —
RESEND_API_KEY=
# Where enquiry notifications are sent (your inbox)
ENQUIRY_TO_EMAIL=dj1982@outlook.com
# Verified sender. Until you verify villamima.com in Resend you can use:
# "Villa Mima <onboarding@resend.dev>"
ENQUIRY_FROM_EMAIL="Villa Mima <onboarding@resend.dev>"

# — Stripe (FUTURE — direct-booking deposits only; not used yet) —
# Leave empty. See src/lib/payments.ts before enabling.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
